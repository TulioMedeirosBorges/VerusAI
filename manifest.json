{
  "manifest_version": 3,
  "name": "VerusAI",
  "key": "",
  "version": "3.5.0",
  "description": "Analise de Noticias",
  "icons": {
    "16": "assets/icons/IconVerusAi.png",
    "32": "assets/icons/IconVerusAi.png",
    "48": "assets/icons/IconVerusAi.png",
    "128": "assets/icons/IconVerusAi.png"
  },
  "permissions": ["storage", "identity", "activeTab"],
  "oauth2": {
    "client_id": "166919224714-251qg7q1abh1h3nenmvekh5agr5ojldv.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*",
    "https://www.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/images/*",
        "assets/icons/*",
        "src/shared/content.css",
        "src/shared/sidebar.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/services/storage.js",
        "src/content/services/api.js",
        "src/content/services/extractor.js",
        "src/content/state.js",
        "src/content/features/reader.js",
        "src/content/features/configs.js",
        "src/content/features/link-preview.js",
        "src/content/features/claim-highlight.js",
        "src/content/ui/popup-login.js",
        "src/content/chat/chat.js",
        "src/content/ui/sidebar.js",
        "src/content/features/share-verus.js",
        "src/content/ui/button.js",
        "src/content/ui/selo-fonte.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_title": "Analiser FakeNews",
    "default_popup": "src/pages/login/login.html",
    "default_icon": {
      "16": "assets/icons/IconVerusAi.png",
      "32": "assets/icons/IconVerusAi.png",
      "48": "assets/icons/IconVerusAi.png",
      "128": "assets/icons/IconVerusAi.png"
    }
  }
}
