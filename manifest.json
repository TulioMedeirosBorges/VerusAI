{
  "manifest_version": 3,
  "name": "analiser FakeNews",
  "key": "",
  "version": "3.0.0",
  "description": "Analise de Noticias",
  "permissions": ["storage", "identity"],
  "oauth2": {
    "client_id": "166919224714-251qg7q1abh1h3nenmvekh5agr5ojldv.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": ["<all_urls>", "http://localhost:3000/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/image/*",
        "assets/icons/*",
        "/style/style.css",
        "style/styleSidebar.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/private/captureFrames.js",
        "js/private/analyzeWithClaude.js",
        "js/public/content.js"
      ],
      "css": [
        "style/style.css",
        "style/stylePopUp.css",
        "style/styleRegister.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Analiser FakeNews",
    "default_popup": "pages/popup.html"
  }
}
