{
  "manifest_version": 3,
  "name": "analiser FakeNews",
  "version": "2.1.0",
  "description": "Analise de Noticias",
  "permissions": [],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["assets/image/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["captureFrames.js", "analyzeWithClaude.js", "content.js"],
      "css": ["style.css", "stylePopUp.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Analiser FakeNews",
    "default_popup": "popup.html"
  }
}
